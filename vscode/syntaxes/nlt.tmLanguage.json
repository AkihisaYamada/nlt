{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "nlt",
  "patterns": [
    {"include": "#comments"},
    {"include": "#block-comments"},
    {"include": "#commands"},
    {"include": "#structures"},
	{"include": "#tags"},
    {"include": "#proof-steps"},
    {"include": "#proof-structures"}
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.double-dash",
        "match": "--([^-].*)?\\n"
      }]
    },
    "block-comments": {
      "name": "comment.block",
      "begin": "---+",
      "end": "---+"
    },
    "commands": {
      "patterns": [{
        "name": "strage.type.nlt",
        "match": ":\\=|\\b(thms?|ctxt|thy|goals?|assume|fix|obtain|import|interpret|note|lemmas?|theorem|proposition|have|show|theory|context|namespace|extend|define|instantiate|retain|set|prefix|infix|syntax)\\b"
      }]
    },
    "structures": {
      "patterns": [{
        "name": "keyword.control.nlt",
        "match": "\\b(begin|end)\\b"
      }]
    },
    "tags": {
      "patterns": [{
        "name": "support.type.property-name",
        "match": ":|!|\\?|#(intro|weak|elim|simp|cong|fallback|rule(_cong)?|dual|fold)\\b"
      }]
	},
    "proof-steps": {
      "patterns": [{
        "name": "keyword.control.nlt",
        "match": ";|\\b(by|simp|apply|(un)?fold|use)\\b"
      }]
    },
    "proof-structures": {
      "patterns": [{
        "name": "support.class.nlt",
        "match": ",|->?|\\.(\\s|$)|\\b(for|if|then|else|where)\\b"
      }]
    }
  },
  "scopeName": "source.nlt"
}
