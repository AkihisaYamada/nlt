{
  "name": "nlt-syntax",
  "displayName": "nlt syntax highlighting and snippets",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.93.1"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "nlt",
      "extensions": [".nl"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nlt",
      "scopeName": "source.nlt",
      "path": "./nlt.tmLanguage.json"
    }],
	"snippets": [
		{
			"language": "nlt",
			"path": "./nlt.code-snippets"
		}
	]
  },
  "repository": {
    "url": "https://github.com/AkihisaYamada/Logic"
  }
}
