{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
{
"name": "debug",
"type": "cppdbg",
"request": "launch",
"program": "${workspaceFolder}/debug",
"args": ["-i","Std/HOL.nl"],
"stopAtEntry": true,
"cwd": "${workspaceFolder}",
"environment": [
	{"name": "ASAN_OPTIONS", "value": "abort_on_error=1"}
],
"externalConsole": false,
"MIMode": "gdb",
"miDebuggerPath": "/usr/bin/gdb",
"setupCommands": [
{
  "description": "Enable pretty-printing for gdb",
  "text": "-enable-pretty-printing",
  "ignoreFailures": true
},
{
"description": "Enable break on all exceptions",
"text": "catch throw std::exception",
"ignoreFailures": true
},
{
	"description": "Clear debuginfod URLs to stop hangs",
	"text": "set debuginfod urls ",
	"ignoreFailures": true
},
],
"preLaunchTask": "make debug"
},
{
"name": "sanitize",
"type": "cppdbg",
"request": "launch",
"program": "${workspaceFolder}/sanitize",
"args": ["Root/Iff.nl"],
"stopAtEntry": true,
"cwd": "${workspaceFolder}",
"environment": [{"name": "ASAN_OPTIONS", "value": "abort_on_error=1"}],
"externalConsole": false,
"MIMode": "gdb",
"miDebuggerPath": "/usr/bin/gdb",
"setupCommands": [
{
  "description": "Enable pretty-printing for gdb",
  "text": "-enable-pretty-printing",
  "ignoreFailures": true
},
{
"description": "Enable break on all exceptions",
"text": "catch throw std::exception",
"ignoreFailures": true
},
],
"preLaunchTask": "make sanitize"
}
]
}
