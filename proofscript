show true_iff_eq: (true ⟺ P) = P, assuming p: P ∈ Prop;
	show 1: (true ⟺ P) = P, assuming P1: P = true;
		unfold* P1;
		by eq_true[OF iff.refl];
	show 2: (true ⟺ P) = P, assuming P0: P = false;
		unfold* P0 true_iff_false_eq;
		done;
	by or_elim[OF p[unfolded IN_Prop] 1 2];

show iff_IN_Prop: (P ⟺ Q) ∈ Prop, assuming p: P ∈ Prop, q: Q ∈ Prop;
	show 1: (P ⟺ Q) ∈ Prop, assuming P1: P = true;
		unfold* P1 true_iff_eq[OF q];
		by q;
	show 2: (P ⟺ Q) ∈ Prop, assuming P0: P = false;
		unfold* P0 false_iff_eq[OF q];
		by not_IN_Prop[OF q];
	by or_elim[OF p[unfolded IN_Prop] 1 2];

show Prop_eq_iff: P = Q ⟺ (P ⟺ Q), assuming p: P ∈ Prop, q: Q ∈ Prop;
	show 1: P = Q ⟺ (P ⟺ Q), assuming P: P = true;
		unfold* P;
		unfold[iff]* true_eq_iff true_iff_iff;
		done;
	show 2: P = Q ⟺ (P ⟺ Q), assuming P0: P = false;
		show 2.1: P = Q ⟹ (P ⟺ Q);
			by eq_imp_iff;
		show 2.2: P = Q, assuming PQ: P ⟺ Q;
			show 2.2.1: P = Q, assuming Q1: Q = true;
				show Q: Q; unfold Q1; done;
				show P: P; by Q[folded[iff] PQ];
				show 0: false; by P[unfolded P0];
				by false.elim[OF 0](P = Q);
			show 2.2.2: P = Q, assuming Q0: Q = false;
				unfold* P0 Q0; done;
			by or_elim[OF q[unfolded IN_Prop] 2.2.1 2.2.2];
		by iff_intro[OF 2.1 2.2];
	by or_elim[OF p[unfolded IN_Prop] 1 2];



