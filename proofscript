define (AND) P ∧ Q := ∀ R. (P ⟹ Q ⟹ R) ⟹ R;

show AND.intro: P ⟹ Q ⟹ P ∧ Q;
	fix P Q;
	assume P: P, Q: Q;
	show 1: ∀ R. (P ⟹ Q ⟹ R) ⟹ R;
		fix R;
		assume PQR: P ⟹ Q ⟹ R;
		by PQR[OF P Q];
	by EQ.prop2[OF AND.def 1];

name AND.elim: EQ.prop1[OF AND.def];

show AND.elim1: P ∧ Q ⟹ P;
	fix P Q;
	assume PQ: P ∧ Q;
	show PQP: P ⟹ Q ⟹ P;
		assume P: P, Q: Q;
		by P;
	by AND.elim[OF PQ PQP];

show AND.elim2: P ∧ Q ⟹ Q;
	fix P Q;
	assume PQ: P ∧ Q;
	show PQQ: P ⟹ Q ⟹ Q;
		assume P: P, Q: Q;
		by Q;
	by AND.elim[OF PQ PQQ];

show mp2: P ∧ (P ⟹ Q) ⟹ Q;
	assume p_pq: P ∧ (P ⟹ Q);
	by AND.elim[OF p_pq mp];

show AND.sym: P ∧ Q ⟹ Q ∧ P;
	assume PQ: P ∧ Q;
	by AND.intro[OF AND.elim2[OF PQ] AND.elim1[OF PQ]];

infix ⟺ 1 1 0;
define (IFF) P ⟺ Q := (P ⟹ Q) ∧ (Q ⟹ P);

show IFF.intro: (P ⟹ Q) ⟹ (Q ⟹ P) ⟹ P ⟺ Q;
	assume PQ: P ⟹ Q, QP: Q ⟹ P;
	show and: (P ⟹ Q) ∧ (Q ⟹ P);
		by AND.intro[OF PQ QP];
	by and[folded IFF.def];

name IFF.elim: EQ.prop1[OF IFF.def][unfolded AND.def];

show IFF.elim1: (P ⟺ Q) ⟹ P ⟹ Q;
	assume PQ: P ⟺ Q;
	by AND.elim1[OF PQ[unfolded IFF.def]];

show IFF.elim2: (P ⟺ Q) ⟹ Q ⟹ P;
	assume PQ: P ⟺ Q;
	by AND.elim2[OF PQ[unfolded IFF.def]];

show IFF.refl: P ⟺ P;
	by IFF.intro[OF IMP.refl IMP.refl];

setup conclude IFF.refl;

show IFF.sym: (P ⟺ Q) ⟹ (Q ⟺ P);
	assume PQ: P ⟺ Q;
	by AND.sym[OF PQ[unfolded IFF.def]][folded IFF.def];

show IFF.trans: (P ⟺ Q) ⟹ (Q ⟺ R) ⟹ P ⟺ R;
	assume PQ: P ⟺ Q, QR: Q ⟺ R;
	show PR: P ⟹ R;
		by IMP.trans[OF IFF.elim1[OF PQ] IFF.elim1[OF QR]];
	show RP: R ⟹ P;
		by IMP.trans[OF IFF.elim2[OF QR] IFF.elim2[OF PQ]];
	by IFF.intro[OF PR RP];

show IFF.cong_IMP: (P ⟺ Q) ⟹ (R ⟺ S) ⟹ (P ⟹ R) ⟺ (Q ⟹ S);
	assume PQ: P ⟺ Q, RS: R ⟺ S;
	show 1: (P ⟹ R) ⟹ (Q ⟹ S);
		assume PR: P ⟹ R;
		show QR: Q ⟹ R; by IMP.trans[OF IFF.elim2[OF PQ] PR];
		by IMP.trans[OF QR IFF.elim1[OF RS]];
	show 2: (Q ⟹ S) ⟹ (P ⟹ R);
		assume QS: Q ⟹ S;
		show PS: P ⟹ S; by IMP.trans[OF IFF.elim1[OF PQ] QS];
		by IMP.trans[OF PS IFF.elim2[OF RS]];
	by IFF.intro[OF 1 2];

show IFF.cong_ALL: (∀x. α[x] ⟺ β[x]) ⟹ (∀)α ⟺ (∀)β;
	assume ab: ∀x. α[x] ⟺ β[x];
	show 1: (∀x. α[x]) ⟹ (∀x. β[x]);
		assume a: ∀x. α[x];
		show b: ∀x. β[x];
			fix x;
			show ax: α[x]; by a;
			by IFF.elim1[OF ab ax];
		by b;
	show 2: (∀x. β[x]) ⟹ (∀x. α[x]);
		assume b: ∀x. β[x];
		show a: ∀x. α[x];
			fix x;
			show bx: β[x]; by b;
			by IFF.elim2[OF ab bx];
		by a;
	by IFF.intro[OF 1 2][unfolded* abs];

show IFF.cong_AND: (P ⟺ Q) ⟹ (R ⟺ S) ⟹ P ∧ R ⟺ Q ∧ S;
	assume PQ: P ⟺ Q, RS: R ⟺ S;
	show 1: P ∧ R ⟹ Q ∧ S;
		assume PR: P ∧ R;
		show P: P; by AND.elim1[OF PR];
		show R: R; by AND.elim2[OF PR];
		show Q: Q; by IFF.elim1[OF PQ P];
		show S: S; by IFF.elim1[OF RS R];
		by AND.intro[OF Q S];
	show 2: Q ∧ S ⟹ P ∧ R;
		assume QS: Q ∧ S;
		show Q: Q; by AND.elim1[OF QS];
		show S: S; by AND.elim2[OF QS];
		show P: P; by IFF.elim2[OF PQ Q];
		show R: R; by IFF.elim2[OF RS S];
		by AND.intro[OF P R];
	by IFF.intro[OF 1 2];

show IFF.cong_IFF: (P ⟺ Q) ⟹ (R ⟺ S) ⟹ (P ⟺ R) ⟺ (Q ⟺ S);
	assume PQ: P ⟺ Q, RS: R ⟺ S;
	show 1: (P ⟺ R) ⟹ (Q ⟺ S);
		assume PR: P ⟺ R;
		show QR: Q ⟺ R; by IFF.trans[OF IFF.sym[OF PQ] PR];
		by IFF.trans[OF QR RS];
	show 2: (Q ⟺ S) ⟹ (P ⟺ R);
		assume QS: Q ⟺ S;
		show PS: P ⟺ S; by IFF.trans[OF PQ QS];
		by IFF.trans[OF PS IFF.sym[OF RS]];
	by IFF.intro[OF 1 2];

setup rewrite[IFF] IFF.refl IFF.sym IFF.trans IFF.elim1;
setup cong[IFF]
	P ⟹ Q: IFF.cong_IMP,
	!(∀)α: IFF.cong_ALL,
	P ⟺ Q: IFF.cong_IFF,
	P ∧ Q: IFF.cong_AND;

show IFF.commute: (P ⟺ Q) ⟺ (Q ⟺ P);
	by IFF.intro[OF IFF.sym IFF.sym];

show AND.commute: P ∧ Q ⟺ Q ∧ P;
	by IFF.intro[OF AND.sym AND.sym];

show AND.assoc: P ∧ (Q ∧ R) ⟺ P ∧ Q ∧ R;
	show 1: P ∧ (Q ∧ R) ⟹ P ∧ Q ∧ R;
		assume PQR: P ∧ (Q ∧ R);
		show P: P; by AND.elim1[OF PQR];
		show Q: Q; by AND.elim1[OF AND.elim2[OF PQR]];
		show R: R; by AND.elim2[OF AND.elim2[OF PQR]];
		by AND.intro[OF AND.intro[OF P Q] R];
	show 2: P ∧ Q ∧ R ⟹ P ∧ (Q ∧ R);
		assume PQR: P ∧ Q ∧ R;
		show P: P; by AND.elim1[OF AND.elim1[OF PQR]];
		show Q: Q; by AND.elim2[OF AND.elim1[OF PQR]];
		show R: R; by AND.elim2[OF PQR];
		by AND.intro[OF P AND.intro[OF Q R]];
	by IFF.intro[OF 1 2];

show EQ_IMP_IFF: P = Q ⟹ P ⟺ Q;
	assume PQ: P = Q;
	by IFF.refl(P)[unfolded(1) PQ];

infix ∨ 30 31 30;
define (OR) P ∨ Q := ∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R;

name OR.intro: EQ.prop2[OF OR.def];

show OR.intro1: P ⟹ P ∨ Q;
	fix P Q;
	assume P: P;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume PR: P ⟹ R, QR: Q ⟹ R;
		by PR[OF P];
	by OR.intro[OF 1];

show OR.intro2: Q ⟹ P ∨ Q;
	fix P Q;
	assume Q: Q;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume PR: P ⟹ R, QR: Q ⟹ R;
		by QR[OF Q];
	by OR.intro[OF 1];

show OR.elim: P ∨ Q ⟹ (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R;
	fix P Q R;
	assume PQ: P ∨ Q, PR: P ⟹ R, QR: Q ⟹ R;
	by EQ.prop1[OF OR.def PQ PR QR];

show IFF.cong_OR: (P ⟺ Q) ⟹ (R ⟺ S) ⟹ P ∨ R ⟺ Q ∨ S;
	assume PQ: P ⟺ Q, RS: R ⟺ S;
	show 1: P ∨ R ⟹ Q ∨ S;
		assume PR: P ∨ R;
		show 1.1: P ⟹ Q ∨ S;
			assume P: P;
			show Q: Q; by IFF.elim1[OF PQ P];
			by OR.intro1[OF Q](S);
		show 1.2: R ⟹ Q ∨ S;
			assume R: R;
			show S: S; by IFF.elim1[OF RS R];
			by OR.intro2[OF S](Q);
		by OR.elim[OF PR 1.1 1.2];
	show 2: Q ∨ S ⟹ P ∨ R;
		assume QS: Q ∨ S;
		show 2.1: Q ⟹ P ∨ R;
			assume Q: Q;
			show P: P; by IFF.elim2[OF PQ Q];
			by OR.intro1[OF P](R);
		show 2.2: S ⟹ P ∨ R;
			assume S: S;
			show R: R; by IFF.elim2[OF RS S];
			by OR.intro2[OF R](P);
		by OR.elim[OF QS 2.1 2.2];
	by IFF.intro[OF 1 2];

setup cong[IFF] P ∨ Q: IFF.cong_OR;

show EQ.commute: x = y ⟺ y = x;
	by IFF.intro[OF EQ.sym EQ.sym];

show OR.sym: P ∨ Q ⟹ Q ∨ P;
	assume PQ: P ∨ Q;
	by OR.elim[OF PQ OR.intro2 OR.intro1];

show OR.commute: P ∨ Q ⟺ Q ∨ P;
	by IFF.intro[OF OR.sym OR.sym];

show OR.assoc: P ∨ (Q ∨ R) ⟺ P ∨ Q ∨ R;
	show 1: P ∨ (Q ∨ R) ⟹ P ∨ Q ∨ R;
		assume PQR: P ∨ (Q ∨ R);
		show 1.1: P ⟹ P ∨ Q ∨ R;
			assume P: P;
			by OR.intro1[OF OR.intro1[OF P]](Q,R);
		show 1.2: Q ∨ R ⟹ P ∨ Q ∨ R;
			assume QR: Q ∨ R;
				show 1.2.1: Q ⟹ P ∨ Q ∨ R;
					assume Q: Q;
					by OR.intro1[OF OR.intro2[OF Q](P)](R);
				show 1.2.2: R ⟹ P ∨ Q ∨ R; by OR.intro2;
			by OR.elim[OF QR 1.2.1 1.2.2];
		by OR.elim[OF PQR 1.1 1.2];
	show 2: P ∨ Q ∨ R ⟹ P ∨ (Q ∨ R);
		assume PQR: P ∨ Q ∨ R;
		show 1.1: P ∨ Q ⟹ P ∨ (Q ∨ R);
			assume PQ: P ∨ Q;
				show 1.1.1: P ⟹ P ∨ (Q ∨ R); by OR.intro1;
				show 1.1.2: Q ⟹ P ∨ (Q ∨ R);
					assume Q: Q;
					by OR.intro2[OF OR.intro1[OF Q](R)](P);
			by OR.elim[OF PQ 1.1.1 1.1.2];
		show 1.2: R ⟹ P ∨ (Q ∨ R);
			assume R: R;
			by OR.intro2[OF OR.intro2[OF R](Q)](P);
		by OR.elim[OF PQR 1.1 1.2];
	by IFF.intro[OF 1 2];

