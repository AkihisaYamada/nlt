prefix ∀ 0 0;
infix ⟹ 1 0 0;

show IMP.refl: ∀P. P ⟹ P;
	assume P: P;
	by P;

show IMP.trans: ∀P. ∀Q. ∀R. (P ⟹ Q) ⟹ (Q ⟹ R) ⟹ P ⟹ R;
	assume PQ: P ⟹ Q;
	assume QR: Q ⟹ R;
	assume P: P;
	name Q: PQ[OF P];
	by QR[OF Q];

show mp: ∀ P. ∀ Q. P ⟹ (P ⟹ Q) ⟹ Q;
	assume P: P;
	assume PQ: P ⟹ Q;
	by PQ[OF P];

show weaken: ∀ P. ∀ Q. P ⟹ Q ⟹ P;
	fix P Q;
	assume P: P, Q: Q;
	by P;

show IMP_ALL: ∀ P. ∀ α. (P ⟹ ∀ x. α[x]) ⟹ ∀ x. P ⟹ α[x];
	fix P α;
	assume 1: P ⟹ ∀ x. α[x];
	show 2: ∀ x. P ⟹ α[x];
		fix x;
		assume P: P;
		by 1[OF P](x);
	by 2;

infix = 50 50 50;
assume EQ.refl: ∀ x. x = x;
assume EQ.mono: ∀ α. ∀ x. ∀ y. x = y ⟹ α[x] ⟹ α[y];
assume EQ.ext: ∀ α. ∀ β. (∀ x. α[x] = β[x]) ⟹ α = β;

show EQ.sym: ∀ x. ∀ y. x = y ⟹ y = x;
	fix x y;
	assume xy: x = y;
	by EQ.mono(z. z = x)[OF xy EQ.refl];

show EQ.trans: ∀ x. ∀ y. ∀ z. x = y ⟹ y = z ⟹ x = z;
	fix x y z;
	assume xy: x = y;
	assume yz: y = z;
	by EQ.mono(w. x = w)[OF yz xy];

show EQ.arg_cong: ∀ x. ∀ y. ∀ f. x = y ⟹ f x = f y;
	fix f x y;
	assume xy: x = y;
	name 1: EQ.refl(f x);
	by EQ.mono(z. f x = f z)[OF xy 1];

show EQ.fun_cong: ∀ f. ∀ g. ∀ x. f = g ⟹ f x = g x;
	fix f g x;
	assume fg: f = g;
	name 1: EQ.refl(f x);
	by EQ.mono(h. f x = h x)[OF fg 1];

show EQ.cong: ∀ f. ∀ g. ∀ x. ∀ y. f = g ⟹ x = y ⟹ f x = g y;
	fix f g x y;
	assume fg: f = g, xy: x = y;
	show 1: f x = f y;
		by EQ.arg_cong[OF xy];
	show 2: f y = g y;
		by EQ.fun_cong[OF fg];
	by EQ.trans[OF 1 2];

show EQ.prop1: ∀ P. ∀ Q. P = Q ⟹ P ⟹ Q;
	by EQ.mono(x. x);

show EQ.prop2: ∀ P. ∀ Q. P = Q ⟹ Q ⟹ P;
	fix P Q;
	assume PQ: P = Q;
	by EQ.prop1[OF EQ.sym[OF PQ]];

setup rewrite cong:EQ.cong fun_cong:EQ.fun_cong arg_cong:EQ.arg_cong ext:EQ.ext refl:EQ.refl trans:EQ.trans eq_imp:EQ.prop1;

prefix λ 0 0;

assume FUN.def: ∀ α. ∀ s. (λ α) s = α[s];

setup define = λ FUN.def;

define TRUE = (∀ P. P ⟹ P);

show TRUE.intro: TRUE;
	name 1: EQ.prop2[OF TRUE.def];
	by 1[OF IMP.refl];

define FALSE = (∀ P. P);

show FALSE.elim: ∀ P. FALSE ⟹ P;
	fix P;
	assume 1: FALSE;
	by EQ.prop1[OF FALSE.def 1](P);

prefix ¬ 10 10;
define (NOT) ∀ P. (¬ P) = (P ⟹ FALSE);

name NOT.intro: EQ.prop2[OF NOT.def];
name NOT.elim: EQ.prop1[OF NOT.def];

show NOT_FALSE: ¬ FALSE;
	by NOT.intro[OF IMP.refl];

infix ≠ 50 50 50;

define (NEQ) ∀ x. ∀ y. (x ≠ y) = (¬ x = y);

name NEQ.intro: EQ.prop2[OF NEQ.def];
name NEQ.elim: EQ.prop1[OF NEQ.def];

show NEQ.irrefl: ∀ x. ¬ x ≠ x;
	fix x;
	show 1: x ≠ x ⟹ FALSE;
		assume 2: x ≠ x;
		show 3: x = x ⟹ FALSE;
			by NOT.elim[OF NEQ.elim[OF 2]];
		by 3[OF EQ.refl];
		by NOT.intro[OF 1];

show TRUE_NEQ_FALSE: TRUE ≠ FALSE;
	show 1: TRUE = FALSE ⟹ FALSE;
		assume 2: TRUE = FALSE;
		by EQ.prop1[OF 2][OF TRUE.intro];
	show 3: ¬ TRUE = FALSE;
		by NOT.intro[OF 1];
	by NEQ.intro[OF 3];

infix ∧ 36 35 36;

define (AND) ∀ P. ∀ Q. (P ∧ Q) = (∀ R. (P ⟹ Q ⟹ R) ⟹ R);

name AND.elim: EQ.prop1[OF AND.def];
name AND.intro: EQ.prop2[OF AND.def];

show mp2: ∀ P. ∀ Q. P ∧ (P ⟹ Q) ⟹ Q;
	assume p_pq: P ∧ (P ⟹ Q);
	by AND.elim[OF p_pq][OF mp];

infix ∨ 31 30 31;

obtain ∨ where OR.def: ∀ P. ∀ Q. (P ∨ Q) = (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
	fix thesis;
	assume 1: ∀ DISJ. (∀ P. ∀ Q. (DISJ P Q) = (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R)) ⟹ thesis;
	by 1(λ P. λ Q. ∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R)[rewrite* FUN.def][OF EQ.refl];

show OR.intro1: ∀ P. ∀ Q. P ⟹ P ∨ Q;
	fix P Q;
	assume P: P;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume PR: P ⟹ R, QR: Q ⟹ R;
		by PR[OF P];
	by EQ.prop2[OF OR.def 1];

show OR.intro2: ∀ P. ∀ Q. Q ⟹ P ∨ Q;
	fix P Q;
	assume Q: Q;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume PR: P ⟹ R, QR: Q ⟹ R;
		by QR[OF Q];
	by EQ.prop2[OF OR.def 1];

show OR.elim: ∀ P. ∀ Q. ∀ R. P ∨ Q ⟹ (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R;
	fix P Q R;
	assume PQ: P ∨ Q, PR: P ⟹ R, QR: Q ⟹ R;
	by EQ.prop1[OF OR.def PQ PR QR];

prefix ∃ 0 1;

define (EX) ∀ α. (∃ α) = (∀ P. (∀ x. α[x] ⟹ P) ⟹ P);

show EX.elim: ∀ α. (∃ x. α[x]) ⟹ ∀ P. (∀ x. α[x] ⟹ P) ⟹ P;
	by EQ.prop1[OF EX.def];

show EX.intro: ∀ α. ∀ x. α[x] ⟹ ∃ y. α[y];
	fix α x;
	assume 1: α[x];
	{	fix P;
		assume 2: ∀ x. α[x] ⟹ P;
		move 3: 2[OF 1];
	}
	by EQ.prop2[OF EX.def](y. α[y])[OF 3];


ctxt;

prefix ∃! 0 1;

define (EX1) ∀ α. (∃! α) = (∀ P. (∀ x. α[x] ⟹ (∀ y. α[y] ⟹ x = y) ⟹ P) ⟹ P);

show EX1.intro: ∀ α. ∀ x. α[x] ⟹ (∀ y. α[y] ⟹ x = y) ⟹ ∃! x. α[x];

show EX1.elim: ∀ α. (∃! x. α[x]) ⟹ ∀ P. (∀ x. α[x] ⟹ (∀ y. α[y] ⟹ x = y) ⟹ P) ⟹ P;

prefix THE 0 1;

assume THE.intro: ∀ α. (∃!) α ⟹ α[(THE) α];


fix IF;
assume IF_TRUE: ∀ x. ∀ y. IF TRUE x y = x;
assume IF_FALSE: ∀ x. ∀ y. IF FALSE x y = y;

fix CONST IS_CONST;

assume CONST_IS_CONST: IS_CONST CONST;

assume CONST.app: ∀ c. IS_CONST c ⟹ ∀ x. IS_CONST (c x);

assume CONST.NEQ_app: ∀ c. IS_CONST c ⟹ ∀ x. CONST ≠ c x;

assume CONST.app_EQ_app:
  ∀ c. ∀ d. IS_CONST c ⟹ IS_CONST d ⟹ ∀ x. ∀ y. c x = d y ⟹ c = d ∧ x = y;

define CONST_ARG v = (THE x. ∃ c. IS_CONST c ∧ v = c x);

show CONST_ARG: ∀ c. IS_CONST c ⟹ ∀ x. CONST_ARG (c x) = x;


define 0 = CONST TRUE;
define SUC = CONST FALSE;



assume EQ_TRUE: ∀ P. P ⟹ P = TRUE;

assume EQ_FALSE: ∀ P. ¬ P ⟹ P = FALSE;

define ∀ f. INJECTIVE f = (∀ x x'. f x = f x' ⟹ x = x');


