prefix ∀ 0 0;
infix ⟹ 1 0 0;

show IMP.refl: ∀ P. P ⟹ P;
	assume P: P;
	by P;

show IMP.trans: ∀ P. ∀ Q. ∀ R. (P ⟹ Q) ⟹ (Q ⟹ R) ⟹ P ⟹ R;
	assume PQ: P ⟹ Q;
	assume QR: Q ⟹ R;
	assume P: P;
	name Q: PQ[P];
	by QR[Q];

show mp: ∀ P. ∀ Q. P ⟹ (P ⟹ Q) ⟹ Q;
	assume P: P;
	assume PQ: P ⟹ Q;
	by PQ[P];

show weaken: ∀ P. ∀ Q. P ⟹ Q ⟹ P;
	fix P Q;
	assume P: P, Q: Q;
	by P;

infix = 50 50 50;

assume EQ.refl: ∀ x. x = x;
assume EQ.mono: ∀ x. ∀ y. ∀ α. x = y ⟹ α[x] ⟹ α[y];

show EQ.sym: ∀ x. ∀ y. x = y ⟹ y = x;
	fix x y;
	assume xy: x = y;
	name xx: EQ.refl(x);
	by EQ.mono(x, y, z. z = x)[xy,xx];

show EQ.trans: ∀ x. ∀ y. ∀ z. x = y ⟹ y = z ⟹ x = z;
	fix x y z;
	assume xy: x = y;
	assume yz: y = z;
	by EQ.mono(y, z, w. x = w)[yz,xy];

show EQ.arg_cong: ∀ f. ∀ x. ∀ y. x = y ⟹ f x = f y;
	fix f x y;
	assume xy: x = y;
	name 1: EQ.refl(f x);
	by EQ.mono(x, y, z. f x = f z)[xy,1];

show EQ.fun_cong: ∀ f. ∀ g. ∀ x. f = g ⟹ f x = g x;
	fix f g x;
	assume fg: f = g;
	name 1: EQ.refl(f x);
	by EQ.mono(f, g, h. f x = h x)[fg,1];

show EQ.cong: ∀ f. ∀ g. ∀ x. ∀ y. f = g ⟹ x = y ⟹ f x = g y;
	fix f g x y;
	assume fg: f = g, xy: x = y;
	show 1: f x = f y;
		by EQ.arg_cong(f,x,y)[xy];
	show 2: f y = g y;
		by EQ.fun_cong(f,g,y)[fg];
	by EQ.trans(f x, f y, g y)[1,2];

show EQ.prop1: ∀ P. ∀ Q. P = Q ⟹ P ⟹ Q;
	fix P Q;
	assume PQ: P = Q;
	by EQ.mono(P, Q, x. x)[PQ];

show EQ.prop2: ∀ P. ∀ Q. P = Q ⟹ Q ⟹ P;
	fix P Q;
	assume PQ: P = Q;
	name 1: EQ.sym(P,Q)[PQ];
	by EQ.prop1(Q,P)[1];

show IMP_ALL: ∀ P. ∀ α. (P ⟹ ∀ x. α[x]) ⟹ ∀ x. P ⟹ α[x];
	assume 1: P ⟹ ∀ x. α[x];
	show 2: ∀ x. P ⟹ α[x];
		fix x;
		assume P: P;
		by 1[P](x);
	by 2;

obtain TRUE where TRUE.def: TRUE = (∀ P. P ⟹ P);
	fix thesis;
	assume 1: ∀ TRUE. TRUE = (∀ P. P ⟹ P) ⟹ thesis;
	name 2: EQ.refl(∀ P. P ⟹ P);
	by 1(∀ P. P ⟹ P)[2];

name TRUE.intro: EQ.prop2(TRUE, ∀ P. P ⟹ P)[TRUE.def, IMP.refl];

obtain FALSE where FALSE.def: FALSE = (∀ P. P);
	fix thesis;
	assume 1: ∀ FALSE. FALSE = (∀ P. P) ⟹ thesis;
	name 2: EQ.refl(∀ P. P);
	by 1(∀ P. P)[2];

show FALSE.elim: ∀ P. FALSE ⟹ P;
	fix P;
	assume 1: FALSE;
	name 2: EQ.prop1(FALSE, ∀ P. P)[FALSE.def];
	by 2[1](P);

prefix λ 0 0;

assume ABS.def: ∀ α. ∀ s. λ α s = α[s];

infix ∧ 36 35 36;

assume AND.def: ∀ P. ∀ Q. (P ∧ Q) = (∀ R. (P ⟹ Q ⟹ R) ⟹ R);

{	fix P Q;
	name 1: AND.def(P,Q);
	move AND.elim: EQ.prop1(P ∧ Q, ∀ R. (P ⟹ Q ⟹ R) ⟹ R)[1];
	move AND.intro: EQ.prop2(P ∧ Q, ∀ R. (P ⟹ Q ⟹ R) ⟹ R)[1];
}
{	assume p_pq: P ∧ (P ⟹ Q);
	name 1: AND.elim(P, P ⟹ Q)[p_pq];
	name 2: 1(Q)[mp(P,Q)];
	move mp2: 2;
}

infix ∨ 31 30 31;

assume OR.def: ∀ P. ∀ Q. (P ∨ Q) = (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);

show OR.intro1: ∀ P. ∀ Q. P ⟹ P ∨ Q;
	fix P Q;
	assume P: P;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume 2: P ⟹ R, _: Q ⟹	R;
		by 2[P];
	name 3: OR.def(P,Q);
	by EQ.prop2(P ∨ Q, ∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R)[3,1];


prefix ∃ 0 1;

assume EX.def: ∀ α. (∃ α) = (∀ P. (∀ x. α[x] ⟹ P) ⟹ P);

{	fix α;
	name 1: EX.def(α);
	move EX.elim: EQ.prop1(∃ α, ∀ P. (∀ x. α[x] ⟹ P) ⟹ P)[1];
	move EX.intro: EQ.prop2(∃ α, ∀ P. (∀ x. α[x] ⟹ P) ⟹ P)[1];
}

ctxt;