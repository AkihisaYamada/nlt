show IMP.refl: P ⟹ P;
	assume P: P;
	by P;

show IMP.trans: (P ⟹ Q) ⟹ (Q ⟹ R) ⟹ P ⟹ R;
	assume PQ: P ⟹ Q;
	assume QR: Q ⟹ R;
	assume P: P;
	name Q: PQ[OF P];
	by QR[OF Q];

show mp: P ⟹ (P ⟹ Q) ⟹ Q;
	assume P: P;
	assume PQ: P ⟹ Q;
	by PQ[OF P];

show weaken: P ⟹ Q ⟹ P;
	fix P Q;
	assume P: P, Q: Q;
	by P;

show IMP.commute: (P ⟹ Q ⟹ R) ⟹ Q ⟹ P ⟹ R;
	assume PQR: P ⟹ Q ⟹ R, Q: Q, P: P;
	by PQR[OF P Q];

show insert: (P ⟹ Q) ⟹ (R ⟹ P) ⟹ R ⟹ Q;
	by IMP.commute[OF IMP.trans];

show IMP_ALL: (P ⟹ ∀ x. α[x]) ⟹ ∀ x. P ⟹ α[x];
	fix P α;
	assume 1: P ⟹ ∀ x. α[x];
	show 2: ∀ x. P ⟹ α[x];
		fix x;
		assume P: P;
		by 1[OF P](x);
	by 2;

