assume EQ.refl: ∀x. x = x;
assume EQ.mono: ∀ α. ∀x. ∀y. x = y ⟹ α[x] ⟹ α[y];
assume EQ.ext: ∀ α. ∀ β. (∀x. α[x] = β[x]) ⟹ α = β;

setup conclude EQ.refl;

show abs: (x. α[x]) = α;
	show 1: ∀x. α[x] = α[x];
		by EQ.refl;
	by EQ.ext(x. α[x])(α)[OF 1];

show EQ.sym: x = y ⟹ y = x;
	fix x y;
	assume xy: x = y;
	by EQ.mono(z. z = x)[OF xy EQ.refl];

show EQ.trans: x = y ⟹ y = z ⟹ x = z;
	fix x y z;
	assume xy: x = y;
	assume yz: y = z;
	by EQ.mono(w. x = w)[OF yz xy];

show EQ.arg_cong: x = y ⟹ f x = f y;
	fix f x y;
	assume xy: x = y;
	name 1: EQ.refl(f x);
	by EQ.mono(z. f x = f z)[OF xy 1];

show EQ.fun_cong: f = g ⟹ f x = g x;
	fix f g x;
	assume fg: f = g;
	name 1: EQ.refl(f x);
	by EQ.mono(h. f x = h x)[OF fg 1];

show EQ.cong: f = g ⟹ x = y ⟹ f x = g y;
	fix f g x y;
	assume fg: f = g, xy: x = y;
	show 1: f x = f y;
		by EQ.arg_cong[OF xy];
	show 2: f y = g y;
		by EQ.fun_cong[OF fg];
	by EQ.trans[OF 1 2];

show EQ.prop1: P = Q ⟹ P ⟹ Q;
	by EQ.mono(x. x);

show EQ.prop2: P = Q ⟹ Q ⟹ P;
	fix P Q;
	assume PQ: P = Q;
	by EQ.prop1[OF EQ.sym[OF PQ]];

setup rewrite EQ.refl EQ.sym EQ.trans EQ.prop1;
setup cong
