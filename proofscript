prefix ∀ 0 0;
infix ⟹ 1 0 0;

show IMP.refl: ∀ P. P ⟹ P;
	assume P: P;
	by P;

show IMP.trans: ∀ P. ∀ Q. ∀ R. (P ⟹ Q) ⟹ (Q ⟹ R) ⟹ P ⟹ R;
	assume PQ: P ⟹ Q;
	assume QR: Q ⟹ R;
	assume P: P;
	name Q: PQ[OF P];
	by QR[OF Q];

show mp: ∀ P. ∀ Q. P ⟹ (P ⟹ Q) ⟹ Q;
	assume P: P;
	assume PQ: P ⟹ Q;
	by PQ[OF P];

show weaken: ∀ P. ∀ Q. P ⟹ Q ⟹ P;
	fix P Q;
	assume P: P, Q: Q;
	by P;

infix = 50 50 50;

assume EQ.refl: ∀ x. x = x;
assume EQ.mono: ∀ α. ∀ x. ∀ y. x = y ⟹ α[x] ⟹ α[y];
assume EQ.ext: ∀ α. ∀ β. (∀ x. α[x] = β[x]) ⟹ α = β;

show EQ.sym: ∀ x. ∀ y. x = y ⟹ y = x;
	fix x y;
	assume xy: x = y;
	by EQ.mono(z. z = x)[OF xy EQ.refl];

show EQ.trans: ∀ x. ∀ y. ∀ z. x = y ⟹ y = z ⟹ x = z;
	fix x y z;
	assume xy: x = y;
	assume yz: y = z;
	by EQ.mono(w. x = w)[OF yz xy];

show EQ.arg_cong: ∀ x. ∀ y. ∀ f. x = y ⟹ f x = f y;
	fix f x y;
	assume xy: x = y;
	name 1: EQ.refl(f x);
	by EQ.mono(z. f x = f z)[OF xy 1];

show EQ.fun_cong: ∀ f. ∀ g. ∀ x. f = g ⟹ f x = g x;
	fix f g x;
	assume fg: f = g;
	name 1: EQ.refl(f x);
	by EQ.mono(h. f x = h x)[OF fg 1];

show EQ.cong: ∀ f. ∀ g. ∀ x. ∀ y. f = g ⟹ x = y ⟹ f x = g y;
	fix f g x y;
	assume fg: f = g, xy: x = y;
	show 1: f x = f y;
		by EQ.arg_cong[OF xy];
	show 2: f y = g y;
		by EQ.fun_cong[OF fg];
	by EQ.trans[OF 1 2];

show EQ.prop1: ∀ P. ∀ Q. P = Q ⟹ P ⟹ Q;
	by EQ.mono(x. x);

show EQ.prop2: ∀ P. ∀ Q. P = Q ⟹ Q ⟹ P;
	fix P Q;
	assume PQ: P = Q;
	by EQ.prop1[OF EQ.sym[OF PQ]];

setup rewrite cong:EQ.cong fun_cong:EQ.fun_cong arg_cong:EQ.arg_cong ext:EQ.ext refl:EQ.refl trans:EQ.trans eq_imp:EQ.prop1;

show IMP_ALL: ∀ P. ∀ α. (P ⟹ ∀ x. α[x]) ⟹ ∀ x. P ⟹ α[x];
	fix P α;
	assume 1: P ⟹ ∀ x. α[x];
	show 2: ∀ x. P ⟹ α[x];
		fix x;
		assume P: P;
		by 1[OF P](x);
	by 2;

obtain TRUE where TRUE.def: TRUE = (∀ P. P ⟹ P);
	fix thesis;
	assume 1: ∀ TRUE. TRUE = (∀ P. P ⟹ P) ⟹ thesis;
	by 1[OF EQ.refl];

show TRUE.intro: TRUE;
	name 1: EQ.prop2[OF TRUE.def];
	by 1[OF IMP.refl];

obtain FALSE where FALSE.def: FALSE = (∀ P. P);
	fix thesis;
	assume 1: ∀ FALSE. FALSE = (∀ P. P) ⟹ thesis;
	by 1[OF EQ.refl];

show FALSE.elim: ∀ P. FALSE ⟹ P;
	fix P;
	assume 1: FALSE;
	by EQ.prop1[OF FALSE.def 1](P);

prefix λ 0 0;

assume FUN.def: ∀ α. ∀ s. (λ α) s = α[s];

infix ∧ 36 35 36;

obtain ∧ where AND.def: ∀ P. ∀ Q. (P ∧ Q) = (∀ R. (P ⟹ Q ⟹ R) ⟹ R);
	fix thesis;
	assume 1: ∀ CONJ. (∀ P. ∀ Q. (CONJ P Q) = (∀ R. (P ⟹ Q ⟹ R) ⟹ R)) ⟹ thesis;
	name 2: 1(λ P2. λ Q2. ∀ R. (P2 ⟹ Q2 ⟹ R) ⟹ R);
	by 2[rewrite FUN.def][rewrite FUN.def][OF EQ.refl];

name AND.elim: EQ.prop1[OF AND.def];
name AND.intro: EQ.prop2[OF AND.def];

show mp2: ∀ P. ∀ Q. P ∧ (P ⟹ Q) ⟹ Q;
	assume p_pq: P ∧ (P ⟹ Q);
	by AND.elim[OF p_pq][OF mp];

infix ∨ 31 30 31;

obtain ∨ where OR.def: ∀ P. ∀ Q. (P ∨ Q) = (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
	fix thesis;
	assume 1: ∀ DISJ. (∀ P. ∀ Q. (DISJ P Q) = (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R)) ⟹ thesis;
	by 1(λ P2. λ Q2. ∀ R. (P2 ⟹ R) ⟹ (Q2 ⟹ R) ⟹ R)[rewrite FUN.def][rewrite FUN.def][OF EQ.refl];

show OR.intro1: ∀ P. ∀ Q. P ⟹ P ∨ Q;
	fix P Q;
	assume P: P;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume PR: P ⟹ R, QR: Q ⟹ R;
		by PR[OF P];
	by EQ.prop2[OF OR.def 1];

show OR.intro2: ∀ P. ∀ Q. Q ⟹ P ∨ Q;
	fix P Q;
	assume Q: Q;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume PR: P ⟹ R, QR: Q ⟹ R;
		by QR[OF Q];
	by EQ.prop2[OF OR.def 1];

show OR.elim: ∀ P. ∀ Q. ∀ R. P ∨ Q ⟹ (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R;
	fix P Q R;
	assume PQ: P ∨ Q, PR: P ⟹ R, QR: Q ⟹ R;
	by EQ.prop1[OF OR.def PQ PR QR];


prefix ∃ 0 1;

obtain ∃ where EX.def: ∀ α. (∃ α) = (∀ P. (∀ x. α[x] ⟹ P) ⟹ P);
	fix thesis;
	assume 1: ∀ EX. (∀ α. (EX α) = (∀ P. (∀ x. α[x] ⟹ P) ⟹ P)) ⟹ thesis;
	by 1(λ α2. ∀ P. (∀ x. α2[x] ⟹ P) ⟹ P)[rewrite FUN.def][OF EQ.refl];

show EX.elim: ∀ α. (∃ α) ⟹ ∀ P. (∀ x. α[x] ⟹ P) ⟹ P;
	by EQ.prop1[OF EX.def];

show EX.intro: ∀ α. (∀ P. (∀ x. α[x] ⟹ P) ⟹ P) ⟹ ∃ α;
	by EQ.prop2[OF EX.def];


ctxt;

thm FUN.def(z. λ w. C[w]);
