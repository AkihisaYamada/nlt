	assume 1: ∀ ∈. (∀x. ∀P. (x ∈ Collect P) = P x) ⟹ thesis;
	define (IN) x ∈ X := const_arg X x;
	show 2: ∀x. ∀P. (x ∈ Collect P) = P x;
		fix x P;
		show 3: (x ∈ Collect P) = const_arg (Collect P) x;
			by IN.def;
		show 4: const_arg (Collect P) = P;
			by const_arg[OF Collect.is_const];
		by 3[unfolded 4];
	by 1[OF 2];

