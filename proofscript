show imp_IN_Prop: P ∈ Prop ⟹ Q ∈ Prop ⟹ (P ⟹ Q) ∈ Prop;
	assume p: P ∈ Prop, q: Q ∈ Prop;
	show 1: P = true ⟹ (P ⟹ Q) ∈ Prop;
		assume P1: P = true;
		show it: (P ⟹ Q) ∈ Prop;
			unfold* P1 true_imp_eq;
			by q;
		by it;
	show 2: P = false ⟹ (P ⟹ Q) ∈ Prop;
		assume P0: P = false;
		show it: (P ⟹ Q) ∈ Prop;
			unfold* P0 false_imp_eq;
			by true_IN_Prop;
		by it;
	by or_elim[OF p[unfolded IN_Prop] 1 2];

