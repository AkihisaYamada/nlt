prefix ∀ 1 1;
infix ⟹ 1 2 1;

show refl: ∀ P. P ⟹ P;
	assume P: P;
	by P;

show weaken: ∀ P. ∀ Q. P ⟹ Q ⟹ P
	fix P Q;
	assume P: P, Q: Q;
	by P;

show mp: ∀ P. ∀ Q. P ⟹ (P ⟹ Q) ⟹ Q;
	assume P: P;
	assume PQ: P ⟹ Q;
	by PQ[P];

infix = 50 50 50;

assume EQ.refl: ∀ x. x = x;
assume EQ.sym: ∀ x. ∀ y. x = y ⟹ y = x;
assume EQ.trans: ∀ x. ∀ y. ∀ z. x = y ⟹ y = z ⟹ x = z;
assume EQ.cong: ∀ f. ∀ g. ∀ x. ∀ y. f = g ⟹ x = y ⟹ f x = g y;

show EQ.arg_cong: ∀ f. ∀ x. ∀ y. x = y ⟹ f x = f y;
	fix f x y;
	name ff: EQ.refl(f);
	by EQ.cong(f,f,x,y)[ff];

assume EQ.prop1: ∀ P. ∀ Q. P = Q ⟹ P ⟹ Q;
show EQ.prop2: ∀ P. ∀ Q. P = Q ⟹ Q ⟹ P;
	assume PQ: P = Q;
	name 1: EQ.sym(P,Q)[PQ];
	by EQ.prop1(Q,P)[1];

show IMP_ALL: ∀ P. ∀ α. (P ⟹ ∀ x. α[x]) ⟹ ∀ x. P ⟹ α[x];
	assume 1: P ⟹ ∀ x. α[x];
	show 2: ∀ x. P ⟹ α[x];
		fix x;
		assume P: P;
		by 1[P](x);
	by 2;

fix TRUE;

assume TRUE.def: TRUE = (∀ P. P ⟹ P);

name TRUE.intro: EQ.prop2(TRUE, ∀ P. P ⟹ P)[TRUE.def, refl];

fix FALSE;

assume FALSE.def: FALSE = (∀ P. P);

show FALSE.elim: ∀ P. FALSE ⟹ P;
	fix P;
	assume 1: FALSE;
	name 2: EQ.prop1(FALSE, ∀ P. P)[FALSE.def];
	by 2[1](P);

infix ∧ 36 35 36;

assume AND.def: ∀ P. ∀ Q. (P ∧ Q) = (∀ R. (P ⟹ Q ⟹ R) ⟹ R);

{	fix P Q;
	name 1: AND.def(P,Q);
	move AND.elim: EQ.prop1(P ∧ Q, ∀ R. (P ⟹ Q ⟹ R) ⟹ R)[1];
	move AND.intro: EQ.prop2(P ∧ Q, ∀ R. (P ⟹ Q ⟹ R) ⟹ R)[1];
}
{	assume p_pq: P ∧ (P ⟹ Q);
	name 1: AND.elim(P, P ⟹ Q)[p_pq];
	name 2: 1(Q)[mp(P,Q)];
	move mp2: 2;
}

infix ∨ 31 30 31;

assume OR.def: ∀ P. ∀ Q. (P ∨ Q) = (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);

show OR.intro1: ∀ P. ∀ Q. P ⟹ P ∨ Q;
	fix P Q;
	assume P: P;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume 2: P ⟹ R, _: Q ⟹	R;
		by 2[P];
	name 3: OR.def(P,Q);
	by EQ.prop2(P ∨ Q, ∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R)[3,1];


prefix ∃ 1 1;

assume EX.def: ∀ α. (∃ α) = (∀ P. (∀ x. α[x] ⟹ P) ⟹ P);

{	fix α;
	name 1: EX.def(α);
	move EX.elim: EQ.prop1(∃ α, ∀ P. (∀ x. α[x] ⟹ P) ⟹ P)[1];
	move EX.intro: EQ.prop2(∃ α, ∀ P. (∀ x. α[x] ⟹ P) ⟹ P)[1];
}

ctxt;