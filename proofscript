				unfold* Q0 and_false_eq;
				by false_IN_Prop;
			by it;
		by or_elim[OF q[unfolded IN_Prop] 1.1 1.2];
	show 2: P = false ⟹ (P ∧ Q) ∈ Prop;
		assume P0: P = false;
		show it: (P ∧ Q) ∈ Prop;
			unfold* P0 false_and_eq;
