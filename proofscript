define (AND) P ∧ Q := ∀ R. (P ⟹ Q ⟹ R) ⟹ R;

show AND.intro: P ⟹ Q ⟹ P ∧ Q;
	fix P Q;
	assume P: P, Q: Q;
	show 1: ∀ R. (P ⟹ Q ⟹ R) ⟹ R;
		fix R;
		assume PQR: P ⟹ Q ⟹ R;
		by PQR[OF P Q];
	by EQ.prop2[OF AND.def 1];

name AND.elim: EQ.prop1[OF AND.def];

show AND.elim1: P ∧ Q ⟹ P;
	fix P Q;
	assume PQ: P ∧ Q;
	show PQP: P ⟹ Q ⟹ P;
		assume P: P, Q: Q;
		by P;
	by AND.elim[OF PQ PQP];

show AND.elim2: P ∧ Q ⟹ Q;
	fix P Q;
	assume PQ: P ∧ Q;
	show PQQ: P ⟹ Q ⟹ Q;
		assume P: P, Q: Q;
		by Q;
	by AND.elim[OF PQ PQQ];

show mp2: P ∧ (P ⟹ Q) ⟹ Q;
	assume p_pq: P ∧ (P ⟹ Q);
	by AND.elim[OF p_pq mp];

show AND.sym: P ∧ Q ⟹ Q ∧ P;
	assume PQ: P ∧ Q;
	by AND.intro[OF AND.elim2[OF PQ] AND.elim1[OF PQ]];

show NOT_AND1: ¬P ⟹ ¬(P ∧ Q);
	assume nP: ¬P;
	show 1: P ∧ Q ⟹ False;
		assume PQ: P ∧ Q;
		by NOT_IMP_False[OF nP AND.dest1[OF PQ]];
	by NOT.intro[OF 1];

show NOT_AND2: ¬Q ⟹ ¬(P ∧ Q);
	assume nQ: ¬Q;
	show 1: P ∧ Q ⟹ False;
		assume PQ: P ∧ Q;
		by NOT_IMP_False[OF nQ AND.dest2[OF PQ]];
	by NOT.intro[OF 1];

infix ⟺ 1 0 0;
define (IFF) P ⟺ Q　:= (P ⟹ Q) ∧ (Q ⟹ P);

name IFF.elim: EQ.prop1[OF IFF.def, unfolded AND.def];

show IFF.elim1: (P ⟺ Q) ⟹ P ⟹ Q;
	assume PQ: P ⟺ Q;
	by AND.elim1[OF PQ[unfolded IFF.def]];

show IFF.elim2: (P ⟺ Q) ⟹ Q ⟹ P;
	assume PQ: P ⟺ Q;
	by AND.elim2[OF PQ[unfolded IFF.def]];

show IFF.sym: (P ⟺ Q) ⟹ (Q ⟺ P);
	assume PQ: P ⟺ Q;
	by AND.sym[OF PQ[unfolded IFF.def]][folded IFF.def];

show NOT_IFF_NOT: (P ⟺ Q) ⟹ ¬P ⟺ ¬Q;
	assume PQ: P ⟺ Q;
	show 1: ¬P ⟹ ¬Q;
		assume nP: ¬P;
		show Q0: Q ⟹ False;
			assume Q: Q;
			show P: P; by IFF.elim2[OF PQ Q];
			by NOT_IMP_False[OF nP P];
		by NOT.intro[OF Q0];
	show 2: ¬Q ⟹ ¬P;
		assume nQ: ¬Q;
		show P0: P ⟹ False;
			assume P: P;
			show Q: Q; by IFF.elim1[OF PQ P];
			by NOT_IMP_False[OF nQ Q];
		by NOT.intro[OF P0];
	by IFF.intro[OF 1 2];

show AND_IFF_AND1:　(P ⟺ Q) ⟹ P ∧ R ⟺ Q ∧ R;
	assume PQ: P ⟺ Q;
	show 1: P ∧ R ⟹ Q ∧ R;
		assume PR: P ∧ R;
		show P: P; by AND.elim1[OF PR];
		show R: R; by AND.elim2[OF PR];
		show Q: Q; by IFF.elim1[OF PQ P];
		by AND.intro[OF Q R];
	show 2: Q ∧ R ⟹ P ∧ R;
		assume QR: Q ∧ R;
		show Q: Q; by AND.elim1[OF QR];
		show R: R; by AND.elim2[OF QR];
		show P: P; by IFF.elim2[OF PQ Q];
		by AND.intro[OF P R];
	by IFF.intro[OF 1 2];

show AND_IFF_AND2:　(P ⟺ Q) ⟹ R ∧ P ⟺ R ∧ Q;
	assume PQ: P ⟺ Q;
	show 1: R ∧ P ⟹ R ∧ Q;
		assume RP: R ∧ P;
		show P: P; by AND.elim2[OF RP];
		show R: R; by AND.elim1[OF RP];
		show Q: Q; by IFF.elim1[OF PQ P];
		by AND.intro[OF R Q];
	show 2: R ∧ Q ⟹ R ∧ P;
		assume RQ: R ∧ Q;
		show Q: Q; by AND.elim2[OF QR];
		show R: R; by AND.elim1[OF QR];
		show P: P; by IFF.elim2[OF PQ Q];
		by AND.intro[OF R P];
	by IFF.intro[OF 1 2];

infix ∨ 31 30 31;

define (OR) P ∨ Q := ∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R;

name OR.intro: EQ.prop2[OF OR.def 1];

show OR.intro1: P ⟹ P ∨ Q;
	fix P Q;
	assume P: P;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume PR: P ⟹ R, QR: Q ⟹ R;
		by PR[OF P];
	by OR.intro[OF 1];

show OR.intro2: Q ⟹ P ∨ Q;
	fix P Q;
	assume Q: Q;
	show 1: (∀ R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R);
		assume PR: P ⟹ R, QR: Q ⟹ R;
		by QR[OF Q];
	by OR.intro[OF 1];

show OR.elim: P ∨ Q ⟹ (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R;
	fix P Q R;
	assume PQ: P ∨ Q, PR: P ⟹ R, QR: Q ⟹ R;
	by EQ.prop1[OF OR.def PQ PR QR];

show OR_IMP_NAND: P ∨ Q ⟹ ¬(¬P ∧ ¬Q);
	assume PQ: P ∨ Q;
	show 2: ¬P ∧ ¬Q ⟹ False;
		assume 3: ¬P ∧ ¬Q;
		show nP: ¬P; by AND.elim1[OF 3];
		show nQ: ¬Q; by AND.elim2[OF 3];
		show 4: P ⟹ False;
			by NOT_IMP_False[OF nP];
		show 5: Q ⟹ False;
			by NOT_IMP_False[OF nQ];
		by OR.elim[OF PQ 4 5];
	by NOT.intro[OF 2];

show AND_IMP_NOR: P ∧ Q ⟹ ¬(¬P ∨ ¬Q);
	assume PQ: P ∧ Q;
	show P: P; by AND.elim1[OF PQ];
	show Q: Q; by AND.elim2[OF PQ];
	show 1: ¬P ∨ ¬Q ⟹ False;
		assume 2: ¬P ∨ ¬Q;
		show 3: ¬P ⟹ False;
			assume nP: ¬P;
			by NOT_IMP_False[OF nP P];
		show 4: ¬Q ⟹ False;
			assume nQ: ¬Q;
			by NOT_IMP_False[OF nQ Q];
		by OR.elim[OF 2 3 4];
	by NOT.intro[OF 1];

show NOR_IFF: ¬(P ∨ Q) ⟺ ¬P ∧ ¬Q;
	show 1: ¬(P ∨ Q) ⟹ ¬P ∧ ¬Q;
		assume nor: ¬(P ∨ Q);
		show 2: P ⟹ False;
			assume P: P;
			show or: P ∨ Q; by OR.intro1[OF P];
			by NOT_IMP[OF nor or];
		show nP: ¬ P;
			by NOT.intro[OF 2];
		show 3: Q ⟹ False;
			assume Q: Q;
			show or: P ∨ Q; by OR.intro2[OF Q];
		show nQ: ¬ Q;
			by NOT.intro[OF 3];
		by AND.intro[OF nP nQ];
	show 3: ¬P ∧ ¬Q ⟹ ¬(P ∨ Q);
		assume and: ¬P ∧ ¬Q;
		show nP: ¬P; by AND.elim1[OF and];
		show nQ: ¬Q; by AND.elim2[OF and];
		show 4: P ∨ Q ⟹ False;
			assume or: P ∨ Q;
			show 5: P ⟹ False;
				by NOT_IMP_False[OF nP P];
			show 6: Q ⟹ False;
				by NOT_IMP_False[OF nQ Q];
			by OR.elim[OF or 5 6];
		by NOT.intro[OF 4];
	by IFF.intro[OF 1 3];

show NAND_NOT_IFF: ¬(¬P ∧ ¬Q) ⟺ ¬¬(P ∨ Q);
	by NOT_IFF_NOT[OF IFF.sym[OF NOR_IFF]];


