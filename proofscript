symbol ∀ ⟹ λ ∧ ∨ ∃ = ≠ ! ≤;
symbol solo ¬;

prefix ∀ 0 0;
infix ⟹ 1 0 0;

show mp: Q, assuming P: P, PQ: P ⟹ Q;
	by PQ[OF P];

show weaken: P ⟹ Q ⟹ P;
	assume P: P, Q: Q;
	by P;

infix ≤ 51 51 50;

locale Reflexive {
	fix ≤;
	assume refl: ∀x. x ≤ x;
}
locale Transitive {
	fix ≤;
	assume trans: ∀x. ∀y. ∀z. x ≤ y ⟹ y ≤ z ⟹ x ≤ z;
}
locale Preorder {
	import Reflexive;
	import Transitive;
}

infix ~ 51 51 50;

locale Symmetric {
	fix ~;
	assume sym: ∀x. ∀y. x ~ y ⟹ y ~ x;
}
locale Equivalence {
	import Symmetric;
	import Preorder (~);
}

import imp: Preorder (⟹),
	discharge
		fix P;
		assume P: P;
		by P;
	discharge
		fix P Q R;
		assume PQ: P ⟹ Q;
		assume QR: Q ⟹ R;
		assume P: P;
		note Q: PQ[OF P];
		by QR[OF Q];
end

show imp_commute: (P ⟹ Q ⟹ R) ⟹ Q ⟹ P ⟹ R;
	assume PQR: P ⟹ Q ⟹ R, Q: Q, P: P;
	by PQR[OF P Q];

show insert: (P ⟹ Q) ⟹ (R ⟹ P) ⟹ R ⟹ Q;
	by imp_commute[OF imp.trans];

show imp_all: (P ⟹ ∀ x. α[x]) ⟹ ∀ x. P ⟹ α[x];
	assume 1: P ⟹ ∀ x. α[x];
	show 2: ∀ x. P ⟹ α[x];
		fix x;
		assume P: P;
		by 1[OF P](x);
	by 2;

infix ∧ 35 36 36;
locale And {
	fix ∧;
	assume and_intro: ∀P. ∀Q. P ⟹ Q ⟹ P ∧ Q;
	assume and_elim1: ∀P. ∀Q. P ∧ Q ⟹ P;
	assume and_elim2: ∀P. ∀Q. P ∧ Q ⟹ Q;
	import and: Symmetric (∧),
		discharge
			assume PQ: P ∧ Q;
			by and_intro[OF and_elim2[OF PQ] and_elim1[OF PQ]];
	end
	show and_elim: P ∧ Q ⟹ ∀R. (P ⟹ Q ⟹ R) ⟹ R;
		assume PQ: P ∧ Q, PQR: P ⟹ Q ⟹ R;
		by PQR[OF and_elim1[OF PQ] and_elim2[OF PQ]];
}

infix ∨ 30 31 30;
locale Or {
	fix ∨;
	assume or_intro1: ∀P. ∀Q. P ⟹ P ∨ Q;
	assume or_intro2: ∀P. ∀Q. Q ⟹ P ∨ Q;
	assume or_elim: ∀P. ∀Q. ∀R. P ∨ Q ⟹ (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R;
	show or_intro: (∀R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R) ⟹ P ∨ Q;
		assume assm: ∀R. (P ⟹ R) ⟹ (Q ⟹ R) ⟹ R;
		by assm[OF or_intro1 or_intro2];
	import or: Symmetric (∨),
		discharge
			assume PQ: P ∨ Q;
			by or_elim[OF PQ or_intro2 or_intro1];
		end
}

prefix ¬ 40 40;
locale MinimalNot {
	fix ¬ false;
	assume not_imp_false: ∀P. ¬ P ⟹ P ⟹ false;
	assume not_intro: ∀P. (P ⟹ false) ⟹ ¬ P;
	show not_false: ¬false;
		by not_intro[OF imp.refl];

	show imp_not: P ⟹ ¬Q ⟹ ¬(P ⟹ Q);
		assume P: P, nQ: ¬Q;
		show 1: false, assuming PQ: P ⟹ Q;
			show Q: Q; by PQ[OF P];
			by not_imp_false[OF nQ Q];
		by not_intro[OF 1];

	show imp_not_imp: (P ⟹ Q) ⟹ ¬Q ⟹ ¬P;
		assume PQ: P ⟹ Q, nQ: ¬Q;
		show P0: false, assuming P: P;
			by not_imp_false[OF nQ PQ[OF P]];
		by not_intro[OF P0];

	show not_all: ¬ P x ⟹ ¬(∀y. P y);
		assume nPx: ¬ P x;
		show 1: (∀y. P y) ⟹ false;
			assume 2: ∀y. P y;
			show Px: P x;
				by 2;
			by not_imp_false[OF nPx Px];
		by not_intro[OF 1];

	show NN_imp_NN: ¬¬P ⟹ (P ⟹ Q) ⟹ ¬¬Q;
		assume P: ¬¬P, PQ: P ⟹ Q;
		show nQ0: ¬Q ⟹ false;
			assume nQ: ¬Q;
			show nP: ¬P; by imp_not_imp[OF PQ nQ];
			by not_imp_false[OF P nP];
		by not_intro[OF nQ0];

	show NN_N_nimp: ¬¬P ⟹ ¬Q ⟹ ¬(P ⟹ Q);
		assume P: ¬¬P, nQ: ¬Q;
		show PQ0: (P ⟹ Q) ⟹ false;
			assume PQ: P ⟹ Q;
			show Q: ¬¬Q; by NN_imp_NN[OF P PQ];
			by not_imp_false[OF Q nQ];
		by not_intro[OF PQ0];

	show NN_mp: ¬¬P ⟹ ¬¬(P ⟹ Q) ⟹ ¬¬Q;
		assume P: ¬¬P, PQ: ¬¬(P ⟹ Q);
		show nQ0: ¬Q ⟹ false;
			assume nQ: ¬Q;
			show nPQ: ¬(P ⟹ Q); by NN_N_nimp[OF P nQ];
			by not_imp_false[OF PQ nPQ];
		by not_intro[OF nQ0];

	show not_not: P ⟹ ¬¬P;
		assume P: P;
		show 1: ¬P ⟹ false;
			assume nP: ¬P;
			by not_imp_false[OF nP P];
		by not_intro[OF 1];
}

infix ⟺ 1 1 0;
locale Iff {
	assume iff_intro: ∀P. ∀Q. (P ⟹ Q) ⟹ (Q ⟹ P) ⟹ P ⟺ Q;
	assume iff_elim1: ∀P. ∀Q. (P ⟺ Q) ⟹ P ⟹ Q;
	assume iff_elim2: ∀P. ∀Q. (P ⟺ Q) ⟹ Q ⟹ P;
	import iff: Equivalence (⟺),
		discharge
			assume PQ: P ⟺ Q;
			by iff_intro[OF iff_elim2[OF PQ] iff_elim1[OF PQ]];
		discharge
			by iff_intro[OF imp.refl imp.refl];
		discharge
			fix P Q R;
			assume PQ: P ⟺ Q;
			assume QR: Q ⟺ R;
			note PR: imp.trans[OF iff_elim1[OF PQ] iff_elim1[OF QR]];
			note RP: imp.trans[OF iff_elim2[OF QR] iff_elim2[OF PQ]];
			by iff_intro[OF PR RP];
		end

	show iff_commute: (P ⟺ Q) ⟺ (Q ⟺ P);
		by iff_intro[OF iff.sym iff.sym];

	show imp_imp_iff: (P ⟹ Q) ⟺ Q, assuming P: P;
		show 1: Q, assuming PQ: P ⟹ Q;
			by PQ[OF P];
		show 2: Q, assuming Q: Q, P2: P;
			by Q;
		by iff_intro[OF 1 2];

	show iff_cong_imp: (P ⟺ Q) ⟹ (R ⟺ S) ⟹ (P ⟹ R) ⟺ (Q ⟹ S);
		assume PQ: P ⟺ Q, RS: R ⟺ S;
		show 1: (P ⟹ R) ⟹ (Q ⟹ S);
			assume PR: P ⟹ R;
			show QR: Q ⟹ R; by imp.trans[OF iff_elim2[OF PQ] PR];
			by imp.trans[OF QR iff_elim1[OF RS]];
		show 2: (Q ⟹ S) ⟹ (P ⟹ R);
			assume QS: Q ⟹ S;
			show PS: P ⟹ S; by imp.trans[OF iff_elim1[OF PQ] QS];
			by imp.trans[OF PS iff_elim2[OF RS]];
		by iff_intro[OF 1 2];

	show iff_cong_iff: (P ⟺ Q) ⟹ (R ⟺ S) ⟹ (P ⟺ R) ⟺ (Q ⟺ S);
		assume PQ: P ⟺ Q, RS: R ⟺ S;
		show 1: (P ⟺ R) ⟹ (Q ⟺ S);
			assume PR: P ⟺ R;
			show QR: Q ⟺ R; by iff.trans[OF iff.sym[OF PQ] PR];
			by iff.trans[OF QR RS];
		show 2: (Q ⟺ S) ⟹ (P ⟺ R);
			assume QS: Q ⟺ S;
			show PS: P ⟺ S; by iff.trans[OF PQ QS];
			by iff.trans[OF PS iff.sym[OF RS]];
		by iff_intro[OF 1 2];

}

locale MinimalLogic {
import And;
import Or;
import Iff;
import MinimalNot;

setup conclude iff.refl;

setup rewrite[iff] iff.refl iff.sym iff.trans iff_elim1;

show iff_cong_and: (P ⟺ Q) ⟹ (R ⟺ S) ⟹ P ∧ R ⟺ Q ∧ S;
	assume PQ: P ⟺ Q, RS: R ⟺ S;
	show 1: P ∧ R ⟹ Q ∧ S;
		assume PR: P ∧ R;
		show P: P; by and_elim1[OF PR];
		show R: R; by and_elim2[OF PR];
		show Q: Q; by iff_elim1[OF PQ P];
		show S: S; by iff_elim1[OF RS R];
		by and_intro[OF Q S];
	show 2: Q ∧ S ⟹ P ∧ R;
		assume QS: Q ∧ S;
		show Q: Q; by and_elim1[OF QS];
		show S: S; by and_elim2[OF QS];
		show P: P; by iff_elim2[OF PQ Q];
		show R: R; by iff_elim2[OF RS S];
		by and_intro[OF P R];
	by iff_intro[OF 1 2];

show iff_cong_or: (P ⟺ Q) ⟹ (R ⟺ S) ⟹ P ∨ R ⟺ Q ∨ S;
	assume PQ: P ⟺ Q, RS: R ⟺ S;
	show 1: P ∨ R ⟹ Q ∨ S;
		assume PR: P ∨ R;
		show 1.1: P ⟹ Q ∨ S;
			assume P: P;
			show Q: Q; by iff_elim1[OF PQ P];
			by or_intro1[OF Q](S);
		show 1.2: R ⟹ Q ∨ S;
			assume R: R;
			show S: S; by iff_elim1[OF RS R];
			by or_intro2[OF S](Q);
		by or_elim[OF PR 1.1 1.2];
	show 2: Q ∨ S ⟹ P ∨ R;
		assume QS: Q ∨ S;
		show 2.1: Q ⟹ P ∨ R;
			assume Q: Q;
			show P: P; by iff_elim2[OF PQ Q];
			by or_intro1[OF P](R);
		show 2.2: S ⟹ P ∨ R;
			assume S: S;
			show R: R; by iff_elim2[OF RS S];
			by or_intro2[OF R](P);
		by or_elim[OF QS 2.1 2.2];
	by iff_intro[OF 1 2];

show iff_cong_not: (P ⟺ Q) ⟹ ¬P ⟺ ¬Q;
	assume PQ: P ⟺ Q;
	show 1: ¬P ⟹ ¬Q;
		assume nP: ¬P;
		show Q0: Q ⟹ false;
			assume Q: Q;
			show P: P; by iff_elim2[OF PQ Q];
			by not_imp_false[OF nP P];
		by not_intro[OF Q0];
	show 2: ¬Q ⟹ ¬P;
		assume nQ: ¬Q;
		show P0: P ⟹ false;
			assume P: P;
			show Q: Q; by iff_elim1[OF PQ P];
			by not_imp_false[OF nQ Q];
		by not_intro[OF P0];
	by iff_intro[OF 1 2];

setup cong[iff]
	P ⟹ Q: iff_cong_imp,
	P ⟺ Q: iff_cong_iff,
	P ∧ Q: iff_cong_and,
	P ∨ Q: iff_cong_or,
	¬P: iff_cong_not;


show and_commute: P ∧ Q ⟺ Q ∧ P;
	by iff_intro[OF and.sym and.sym];

show or_commute: P ∨ Q ⟺ Q ∨ P;
	by iff_intro[OF or.sym or.sym];
show and_assoc: P ∧ (Q ∧ R) ⟺ P ∧ Q ∧ R;
	show 1: P ∧ (Q ∧ R) ⟹ P ∧ Q ∧ R;
		assume PQR: P ∧ (Q ∧ R);
		show P: P; by and_elim1[OF PQR];
		show Q: Q; by and_elim1[OF and_elim2[OF PQR]];
		show R: R; by and_elim2[OF and_elim2[OF PQR]];
		by and_intro[OF and_intro[OF P Q] R];
	show 2: P ∧ Q ∧ R ⟹ P ∧ (Q ∧ R);
		assume PQR: P ∧ Q ∧ R;
		show P: P; by and_elim1[OF and_elim1[OF PQR]];
		show Q: Q; by and_elim2[OF and_elim1[OF PQR]];
		show R: R; by and_elim2[OF PQR];
		by and_intro[OF P and_intro[OF Q R]];
	by iff_intro[OF 1 2];


show or_assoc: P ∨ (Q ∨ R) ⟺ P ∨ Q ∨ R;
	show 1: P ∨ (Q ∨ R) ⟹ P ∨ Q ∨ R;
		assume PQR: P ∨ (Q ∨ R);
		show 1.1: P ⟹ P ∨ Q ∨ R;
			assume P: P;
			by or_intro1[OF or_intro1[OF P]](Q,R);
		show 1.2: Q ∨ R ⟹ P ∨ Q ∨ R;
			assume QR: Q ∨ R;
				show 1.2.1: Q ⟹ P ∨ Q ∨ R;
					assume Q: Q;
					by or_intro1[OF or_intro2[OF Q](P)](R);
				show 1.2.2: R ⟹ P ∨ Q ∨ R; by or_intro2;
			by or_elim[OF QR 1.2.1 1.2.2];
		by or_elim[OF PQR 1.1 1.2];
	show 2: P ∨ Q ∨ R ⟹ P ∨ (Q ∨ R);
		assume PQR: P ∨ Q ∨ R;
		show 1.1: P ∨ Q ⟹ P ∨ (Q ∨ R);
			assume PQ: P ∨ Q;
				show 1.1.1: P ⟹ P ∨ (Q ∨ R); by or_intro1;
				show 1.1.2: Q ⟹ P ∨ (Q ∨ R);
					assume Q: Q;
					by or_intro2[OF or_intro1[OF Q](R)](P);
			by or_elim[OF PQ 1.1.1 1.1.2];
		show 1.2: R ⟹ P ∨ (Q ∨ R);
			assume R: R;
			by or_intro2[OF or_intro2[OF R](Q)](P);
		by or_elim[OF PQR 1.1 1.2];
	by iff_intro[OF 1 2];

show or_imp_iff: (P ∨ Q ⟹ R) ⟺ (P ⟹ R) ∧ (Q ⟹ R);
	show 1: (P ∨ Q ⟹ R) ⟹ (P ⟹ R) ∧ (Q ⟹ R);
		assume nor: P ∨ Q ⟹ R;
		show PR: P ⟹ R;
			assume P: P;
			show or: P ∨ Q; by or_intro1[OF P];
			by nor[OF or];
		show QR: Q ⟹ R;
			assume Q: Q;
			show or: P ∨ Q; by or_intro2[OF Q];
			by nor[OF or];
		by and_intro[OF PR QR];
	show 2: (P ⟹ R) ∧ (Q ⟹ R) ⟹ P ∨ Q ⟹ R;
		assume and: (P ⟹ R) ∧ (Q ⟹ R), or: P ∨ Q;
		show PR: P ⟹ R; by and_elim1[OF and];
		show QR: Q ⟹ R; by and_elim2[OF and];
		by or_elim[OF or PR QR];
	by iff_intro[OF 1 2];

show not_iff_imp_false: ¬P ⟺ (P ⟹ false);
	by iff_intro[OF not_imp_false not_intro];

show nor_iff: ¬(P ∨ Q) ⟺ ¬P ∧ ¬Q;
	by or_imp_iff(P)(Q)(false)[folded[iff]* not_iff_imp_false];

show not_and1: ¬P ⟹ ¬(P ∧ Q);
	assume nP: ¬P;
	show 1: P ∧ Q ⟹ false;
		assume PQ: P ∧ Q;
		by not_imp_false[OF nP and_elim1[OF PQ]];
	by not_intro[OF 1];

show not_and2: ¬Q ⟹ ¬(P ∧ Q);
	assume nQ: ¬Q;
	show 1: P ∧ Q ⟹ false;
		assume PQ: P ∧ Q;
		by not_imp_false[OF nQ and_elim2[OF PQ]];
	by not_intro[OF 1];

show not3: ¬¬¬P ⟺ ¬P;
	show imp: ¬¬¬P ⟹ ¬P;
		assume nnnP: ¬¬¬P;
		show P0: P ⟹ false;
			assume P: P;
			show nnP0: ¬¬P ⟹ false;
				by not_imp_false[OF nnnP];
			by nnP0[OF not_not[OF P]];
		by not_intro[OF P0];
	show if: ¬P ⟹ ¬¬¬P;
		by not_not;
	by iff_intro[OF imp if];

show consistency: ¬(P ∧ ¬P);
	show 1: P ∧ ¬P ⟹ false;
		assume 2: P ∧ ¬P;
		show P: P; by and_elim1[OF 2];
		show nP: ¬P; by and_elim2[OF 2];
		by not_imp_false[OF nP P];
	by not_intro[OF 1];

show nn_excluded_middle: ¬¬(P ∨ ¬P);
	by consistency(¬P)[folded[iff] nor_iff];

show or_imp_nand: P ∨ Q ⟹ ¬(¬P ∧ ¬Q);
	assume PQ: P ∨ Q;
	show 2: ¬P ∧ ¬Q ⟹ false;
		assume 3: ¬P ∧ ¬Q;
		show nP: ¬P; by and_elim1[OF 3];
		show nQ: ¬Q; by and_elim2[OF 3];
		show 4: P ⟹ false;
			by not_imp_false[OF nP];
		show 5: Q ⟹ false;
			by not_imp_false[OF nQ];
		by or_elim[OF PQ 4 5];
	by not_intro[OF 2];




show N_nand_N_iff: ¬(¬P ∧ ¬Q) ⟺ ¬¬(P ∨ Q);
	by iff.refl(¬(¬P ∧ ¬Q))[folded[iff](1) nor_iff];

show nnand_imp_NN_and_NN: ¬¬(P ∧ Q) ⟹ ¬¬P ∧ ¬¬Q;
	assume PQ: ¬¬(P ∧ Q);
	show nP0: ¬P ⟹ false;
		assume nP: ¬P;
		show nPQ: ¬(P ∧ Q); by not_and1[OF nP];
		by not_imp_false[OF PQ nPQ];
	show P: ¬¬P; by not_intro[OF nP0];
	show nQ0: ¬Q ⟹ false;
		assume nQ: ¬Q;
		show nPQ: ¬(P ∧ Q); by not_and2[OF nQ];
		by not_imp_false[OF PQ nPQ];
	show Q: ¬¬Q; by not_intro[OF nQ0];
	by and_intro[OF P Q];

show false_and_false_iff: false ∧ false ⟺ false;
	show 1: false ∧ false ⟹ false; by and_elim1;
	show 2: false ⟹ false ∧ false;
		assume 0: false;
		by and_intro[OF 0 0];
	by iff_intro[OF 1 2];

show false_or_false_iff: false ∨ false ⟺ false;
	show 1: false ∨ false ⟹ false;
		assume or: false ∨ false;
		by or_elim[OF or imp.refl imp.refl];
	show 2: false ⟹ false ∨ false;
		by or_intro1;
	by iff_intro[OF 1 2];

obtain true where true_intro: true;
	assume assm: ∀true. true ⟹ thesis;
	by assm(∀x. x ⟹ x)[OF imp.refl];

setup conclude true_intro;

show true_imp_iff: (true ⟹ P) ⟺ P;
	by imp_imp_iff[OF true_intro];

show imp_true_iff: (P ⟹ true) ⟺ true;
	show 1: true, assuming 1.1: P ⟹ true;
		by true_intro;
	show 2: true, assuming t: true, P: P;
		by true_intro;
	by iff_intro[OF 1 2];

show true_iff_iff: (true ⟺ P) ⟺ P;
	show 1: (true ⟺ P) ⟹ P;
		assume P1: true ⟺ P;
		show P: P; fold[iff] P1; done;
		by P;
	show 2: P ⟹ (true ⟺ P);
		assume P: P;
		show 2.1: true ⟹ P;
			by weaken[OF P];
		show 2.2: P ⟹ true;
			by weaken[OF true.intro];
		by iff_intro[OF 2.1 2.2];
	by iff_intro[OF 1 2];

show iff_true_iff: (P ⟺ true) ⟺ P;
	unfold[iff](0) iff.commute;
	by true_iff_iff(P);

note iff_true: iff_elim2[OF iff_true_iff];

show false_imp_false_iff: (false ⟹ false) ⟺ true;
	by iff_true[OF imp.refl];

show not_true_iff: ¬true ⟺ false;
	show 1: ¬true, assuming f: false;
		show 1.1: false, assuming t: true;
			by f;
		by not_intro[OF 1.1];
	show 2: false, assuming nt: ¬true;
		by not_imp_false[OF nt true_intro];
	by iff_intro[OF 1 2];

show true_and_iff: true ∧ P ⟺ P;
	show 1: true ∧ P ⟹ P; by and_elim2;
	show 2: true ∧ P, assuming P: P;
		by and_intro[OF true_intro P];
	by iff_intro[OF 1 2];

show and_true_iff: P ∧ true ⟺ P;
	by true_and_iff[unfolded[iff] and.commute];

show true_and_true: true ∧ true;
	unfold[iff] true_and_iff;
	by true.intro;

show true_or: true ∨ P;
	show 1: ∀Q. (true ⟹ Q) ⟹ (P ⟹ Q) ⟹ Q;
		assume Q: true ⟹ Q, PQ: P ⟹ Q;
		by Q[OF true.intro];
	by or_intro[OF 1];

show or_true: P ∨ true;
	by or.sym[OF true_or];

}

locale IntuitionisticLogic {

obtain false where false_elim: ∀P. false ⟹ P;
	assume assm: ∀false. (∀P. false ⟹ P) ⟹ thesis;
	show 1: ∀P. (∀x. x) ⟹ P;
		fix P;
		assume 2: ∀x. x;
		by 2(P);
	by assm(∀P. P)[OF 1];

import MinimalLogic;

setup rewrite[iff] iff.refl iff.sym iff.trans iff_elim1;
setup conclude iff.refl true_intro;

show false_imp_iff: (false ⟹ P) ⟺ true;
	by iff_true[OF false_elim];

show false_and_iff: false ∧ P ⟺ false;
	show 1: false, assuming fP: false ∧ P;
		by and_elim1[OF fP];
	show 2: false ∧ P, assuming f: false;
		by false_elim[OF f];
	by iff_intro[OF 1 2];

show and_false_iff: P ∧ false ⟺ false;
	unfold[iff] and_commute;
	by false_and_iff;


}

show true_eq_imp: true = P ⟹ P;
	assume P1: true = P;
