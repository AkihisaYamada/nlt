define (EX) (∃) α := (∀P. (∀x. α[x] ⟹ P) ⟹ P);

show EX.elim: (∃) α ⟹ (∀x. α[x] ⟹ P) ⟹ P;
	fix α P;
	assume 1: (∃) α;
	by EQ.prop1[OF EX.def 1](P);

show EX.intro: (∀P. (∀x. α[x] ⟹ P) ⟹ P) ⟹ ∃y. α[y];
	by EQ.prop2[OF EX.def](y. α[y]);

show EX.intro1: α[x] ⟹ ∃y. α[y];
	fix α x;
	assume 1: α[x];
	{	fix P;
		assume 2: ∀x. α[x] ⟹ P;
		move 3: 2[OF 1];
	}
	by EX.intro(y. α[y])[OF 3];

show IFF.cong_EX: (∀x. α[x] ⟺ β[x]) ⟹ (∃)α ⟺ (∃)β;
	assume ab: ∀x. α[x] ⟺ β[x];
	show 1: (∃x. α[x]) ⟹ (∃x. β[x]);
		assume a: ∃x. α[x];
		obtain x where ax: α[x]; by EX.elim[OF a];
		show bx: β[x]; by ax[unfolded[IFF] ab];
		by EX.intro1(β)[OF bx];
	show 2: (∃x. β[x]) ⟹ (∃x. α[x]);
		assume b: ∃x. β[x];
		obtain x where bx: β[x]; by EX.elim[OF b];
		show ax: α[x]; by bx[folded[IFF] ab];
		by EX.intro1(α)[OF ax];
	by IFF.intro[OF 1 2][unfolded* abs];

setup cong[IFF] !(∃)α: IFF.cong_EX;


