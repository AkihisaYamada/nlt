assume const_app: ∀ c. is_const c ⟹ ∀ x. is_const (c x);

assume Const_NEQ_app: ∀ c. is_const c ⟹ ∀ x. Const ≠ c x;

assume const_app_EQ_app:
  ∀ c. ∀ d. is_const c ⟹ is_const d ⟹ ∀ x. ∀ y. c x = d y ⟹ c = d ∧ x = y;

define inj f := ∀x. ∀y. f x = f y ⟹ x = y;

show const_inj: is_const c ⟹ inj c;
	assume c: is_const c;
	show 1: ∀x. ∀y. c x = c y ⟹ x = y;
		by insert[OF AND.dest2][OF const_app_EQ_app[OF c c]];
	by 1[folded inj.def];

define const_arg v := (THE x. ∃ c. is_const c ∧ v = c x);

show const_arg: is_const c ⟹ const_arg (c x) = x;
	fix c x;
	assume c: is_const c;
	show 1: ∃ d. is_const d ∧ c x = d x;
		by EX.intro(d. is_const d ∧ c x = d x)[OF AND.intro[OF c EQ.refl]];
	show 2: ∀y. (∃d. is_const d ∧ c x = d y) ⟹ x = y;
		fix y;
		assume 3: ∃d. is_const d ∧ c x = d y;
		obtain d where 4: is_const d ∧ c x = d y;
			by EX.elim[OF 3];
		name d: AND.dest1[OF 4];
		name cxdy: AND.dest2[OF 4];
		show 5: c = d ∧ x = y;
			by const_app_EQ_app[OF c d cxdy];
		by AND.dest2[OF 5];
	show 3: ∃!y. ∃d. is_const d ∧ c x = d y;
		by EX1.intro(y. ∃d. is_const d ∧ c x = d y)[OF 1 2];
	show 4: ∃ d. is_const d ∧ c x = d (const_arg (c x));
		by THE.intro[OF 3][folded const_arg.def];
	obtain d where 5: is_const d ∧ c x = d (const_arg (c x));
		by EX.elim[OF 4];
	show d: is_const d;
		by AND.dest1[OF 5];
	show 6: c x = d (const_arg (c x));
		by AND.dest2[OF 5];
	show 7: x = const_arg (c x);
		by AND.dest2[OF const_app_EQ_app[OF c d 6]];
	by EQ.sym[OF 7];

