define (EX) (∃) α := (∀P. (∀x. α[x] ⟹ P) ⟹ P);

show EX.elim: (∃) α ⟹ (∀ x. α[x] ⟹ P) ⟹ P;
	fix α P;
	assume 1: (∃) α;
	by EQ.prop1[OF EX.def 1](P);

show EX.intro: (∀P. (∀x. α[x] ⟹ P) ⟹ P) ⟹ ∃y. α[y];
	by EQ.prop2[OF EX.def];

show EX.intro1: α[x] ⟹ ∃y. α[y];
	fix α x;
	assume 1: α[x];
	{	fix P;
		assume 2: ∀x. α[x] ⟹ P;
		move 3: 2[OF 1];
	}
	by EX.intro(y. α[y])[OF 3];

show NOT_EX_IFF: ¬(∃x. p x) ⟺ (∀x. ¬p x);
	show 1: ¬(∃x. p x) ⟹ ∀x. ¬p x;
		assume nex: ¬(∃x. p x);
		show nall: ∀x. ¬p x;
			fix x;
			show px0: p x ⟹ False;
				assume px: p x;
				show ex: ∃x. p x; by EX.intro1[OF px];
				by NOT_IMP_False[OF nex ex];
			by NOT.intro[OF px0];
		by nall;
	show 2: (∀x. ¬p x) ⟹ ¬(∃x. p x);
		assume alln: ∀x. ¬p x;
		show ex0: (∃x. p x) ⟹ False;
			assume ex: ∃x. p x;
			show p0: ∀x. p x ⟹ False;
				fix x;
				assume px: p x;
				show npx: ¬ p x; by alln;
				by NOT_IMP_False[OF npx px];
			by EX.elim[OF ex p0];
		by NOT.intro[OF ex0];
	by IFF.intro[OF 1 2];

show NOT_ALL_NOT_IFF: ¬(∀x. ¬p x) ⟺ ¬¬(∃x. p x);
	by NOT_IFF_NOT[OF IFF.sym[OF NOT_EX_IFF]];

define prop P := P ∨ ¬P;

show prop.intro1: P ⟹ prop P;
	assume P: P;
	by EQ.prop2[OF prop.def OR.intro1[OF P]];

show prop.intro2: ¬ P ⟹ prop P;
	assume P: ¬P;
	by EQ.prop2[OF prop.def OR.intro2[OF P]];

show prop.elim: prop P ⟹ (P ⟹ thesis) ⟹ (¬ P ⟹ thesis) ⟹ thesis;
	assume p: prop P;
	by OR.elim[OF p[unfolded prop.def]](thesis);

show prop_NOT: prop P ⟹ prop (¬P);
	assume p: prop P;
	show 1: P ⟹ prop (¬P);
		assume P: P;
		by prop.intro2[OF NOT_NOT[OF P]];
	show 2: ¬P ⟹ prop (¬P);
		by prop.intro1;
	by prop.elim[OF p 1 2];

show prop_IMP: prop P ⟹ prop Q ⟹ prop (P ⟹ Q);
	assume p: prop P, q: prop Q;
	show 1: P ⟹ prop (P ⟹ Q);
		assume P: P;
		show 1.1: Q ⟹ prop (P ⟹ Q);
			assume Q: Q;
			show PQ: P ⟹ Q;
				by weaken[OF Q];
			by prop.intro1[OF PQ];
		show 1.2: ¬Q ⟹ prop (P ⟹ Q);
			assume nQ: ¬Q;
			show nPQ: ¬ (P ⟹ Q);
				by IMP_NOT[OF P nQ];
			by prop.intro2[OF nPQ];
		by prop.elim[OF q 1.1 1.2];
	show 2: ¬P ⟹ prop (P ⟹ Q);
		assume nP: ¬P;
		show PQ: P ⟹ Q;
			by NOT_IMP[OF nP];
		by prop.intro1[OF PQ];
	by prop.elim[OF p 1 2];

show prop_AND: prop P ⟹ prop Q ⟹ prop (P ∧ Q);
	assume P: prop P, Q: prop Q;
	show 1: P ⟹ prop (P ∧ Q);
		assume P: P;
		show 1.1: Q ⟹ prop (P ∧ Q);
			assume Q: Q;
			by prop.intro1[OF AND.intro[OF P Q]];
		show 1.2: ¬Q ⟹ prop (P ∧ Q);
			assume Q: ¬Q;
			by prop.intro2[OF NOT_AND2[OF Q]](P);
		by prop.elim[OF Q 1.1 1.2];
	show 2: ¬P ⟹ prop (P ∧ Q);
		assume P: ¬ P;
		by prop.intro2[OF NOT_AND1[OF P]](Q);
	by prop.elim[OF P 1 2];

show prop_OR: prop P ⟹ prop Q ⟹ prop (P ∨ Q);
	assume P: prop P, Q: prop Q;
	show 1: P ⟹ prop (P ∨ Q);
		assume P: P;
		by prop.intro1[OF OR.intro1[OF P](Q)];
	show 2: ¬P ⟹ prop (P ∨ Q);
		assume P: ¬ P;

