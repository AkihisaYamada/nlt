prefix ¬ 40 40;
define (NOT) ¬ P := P ⟹ False;

name NOT.intro: EQ.prop2[OF NOT.def];
name NOT_IMP_False: EQ.prop1[OF NOT.def];

show NOT_False: ¬False;
	by NOT.intro[OF IMP.refl];

show IMP_NOT: P ⟹ ¬Q ⟹ ¬(P ⟹ Q);
	assume P: P, nQ: ¬Q;
	show 1: False, assuming PQ: P ⟹ Q;
		show Q: Q; by PQ[OF P];
		by NOT_IMP_False[OF nQ Q];
	by NOT.intro[OF 1];

show IMP_NOT_IMP: (P ⟹ Q) ⟹ ¬Q ⟹ ¬P;
	assume PQ: P ⟹ Q, nQ: ¬Q;
	show P0: False, assuming P: P;
		by NOT_IMP_False[OF nQ PQ[OF P]];
	by NOT.intro[OF P0];

show NOT_ALL: ¬ P x ⟹ ¬(∀y. P y);
	assume nPx: ¬ P x;
	show 1: (∀y. P y) ⟹ False;
		assume 2: ∀y. P y;
		show Px: P x;
			by 2;
		by NOT_IMP_False[OF nPx Px];
	by NOT.intro[OF 1];

show NOT_AND1: ¬P ⟹ ¬(P ∧ Q);
	assume nP: ¬P;
	show 1: P ∧ Q ⟹ False;
		assume PQ: P ∧ Q;
		by NOT_IMP_False[OF nP AND.elim1[OF PQ]];
	by NOT.intro[OF 1];

show NOT_AND2: ¬Q ⟹ ¬(P ∧ Q);
	assume nQ: ¬Q;
	show 1: P ∧ Q ⟹ False;
		assume PQ: P ∧ Q;
		by NOT_IMP_False[OF nQ AND.elim2[OF PQ]];
	by NOT.intro[OF 1];

show IFF.cong_NOT: (P ⟺ Q) ⟹ ¬P ⟺ ¬Q;
	assume PQ: P ⟺ Q;
	show 1: ¬P ⟹ ¬Q;
		assume nP: ¬P;
		show Q0: Q ⟹ False;
			assume Q: Q;
			show P: P; by IFF.elim2[OF PQ Q];
			by NOT_IMP_False[OF nP P];
		by NOT.intro[OF Q0];
	show 2: ¬Q ⟹ ¬P;
		assume nQ: ¬Q;
		show P0: P ⟹ False;
			assume P: P;
			show Q: Q; by IFF.elim1[OF PQ P];
			by NOT_IMP_False[OF nQ Q];
		by NOT.intro[OF P0];
	by IFF.intro[OF 1 2];

setup cong[IFF] ¬P: IFF.cong_NOT;

show NOT_NOT: P ⟹ ¬¬P;
	assume P: P;
	show 1: ¬P ⟹ False;
		assume nP: ¬P;
		by NOT_IMP_False[OF nP P];
	by NOT.intro[OF 1];

show consistency: ¬(P ∧ ¬P);
	show 1: P ∧ ¬P ⟹ False;
		assume 2: P ∧ ¬P;
		show P: P; by AND.elim1[OF 2];
		show nP: ¬P; by AND.elim2[OF 2];
		by NOT_IMP_False[OF nP P];
	by NOT.intro[OF 1];

show NN_IMP_NN: ¬¬P ⟹ (P ⟹ Q) ⟹ ¬¬Q;
	assume P: ¬¬P, PQ: P ⟹ Q;
	show nQ0: ¬Q ⟹ False;
		assume nQ: ¬Q;
		show nP: ¬P; by IMP_NOT_IMP[OF PQ nQ];
		by NOT_IMP_False[OF P nP];
	by NOT.intro[OF nQ0];

show NN_N_NIMP: ¬¬P ⟹ ¬Q ⟹ ¬(P ⟹ Q);
	assume P: ¬¬P, nQ: ¬Q;
	show PQ0: (P ⟹ Q) ⟹ False;
		assume PQ: P ⟹ Q;
		show Q: ¬¬Q; by NN_IMP_NN[OF P PQ];
		by NOT_IMP_False[OF Q nQ];
	by NOT.intro[OF PQ0];

show NN_mp: ¬¬P ⟹ ¬¬(P ⟹ Q) ⟹ ¬¬Q;
	assume P: ¬¬P, PQ: ¬¬(P ⟹ Q);
	show nQ0: ¬Q ⟹ False;
		assume nQ: ¬Q;
		show nPQ: ¬(P ⟹ Q); by NN_N_NIMP[OF P nQ];
		by NOT_IMP_False[OF PQ nPQ];
	by NOT.intro[OF nQ0];

show NOT3: ¬¬¬P ⟺ ¬P;
	show imp: ¬¬¬P ⟹ ¬P;
		assume nnnP: ¬¬¬P;
		show P0: P ⟹ False;
			assume P: P;
			show nnP0: ¬¬P ⟹ False;
				by NOT_IMP_False[OF nnnP];
			by nnP0[OF NOT_NOT[OF P]];
		by NOT.intro[OF P0];
	show if: ¬P ⟹ ¬¬¬P;
		by NOT_NOT;
	by IFF.intro[OF imp if];

show OR_IMP_NAND: P ∨ Q ⟹ ¬(¬P ∧ ¬Q);
	assume PQ: P ∨ Q;
	show 2: ¬P ∧ ¬Q ⟹ False;
		assume 3: ¬P ∧ ¬Q;
		show nP: ¬P; by AND.elim1[OF 3];
		show nQ: ¬Q; by AND.elim2[OF 3];
		show 4: P ⟹ False;
			by NOT_IMP_False[OF nP];
		show 5: Q ⟹ False;
